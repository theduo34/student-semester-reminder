# Copy this file to .env.local and fill in the values — see CLAUDE.md's Deployments
# section. termio-admin's own .env.example should use the same values (both apps
# point at the same Convex deployment).

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

EXPO_PUBLIC_CONVEX_URL=

EXPO_PUBLIC_CONVEX_SITE_URL=

AUTH_RESEND_KEY=
